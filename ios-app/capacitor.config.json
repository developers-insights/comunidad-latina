{
  "appId": "com.comunidadlatina.app",
  "appName": "Comunidad Latina",
  "webDir": "www",
  "server": {
    "url": "https://www.comunidadlatina.com/feed?origen=ios",
    "errorPath": "offline.html",
    "allowNavigation": [
      "www.comunidadlatina.com",
      "comunidadlatina.com"
    ]
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#FCFCFB",
    "scheme": "Comunidad Latina"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#FCFCFB",
      "showSpinner": false
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
