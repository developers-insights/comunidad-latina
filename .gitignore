# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Service worker emitido por @serwist/next en cada `next build --webpack`
# (swDest de next.config.ts). Es un bundle de ~62 KB, no código fuente: cambia
# en cada build de cada rama y es imposible de mergear. Vercel lo regenera en
# su propio build, y el precache se versiona por `buildRevision` (hash de
# timestamp + commit sha, next.config.ts) — no por el archivo commiteado, así
# que sacarlo del índice no afecta la actualización del SW en producción.
# eslint.config.mjs ya lo ignoraba; esto cierra la otra mitad.
/public/sw.js
/public/sw.js.map

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.example.*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Artefactos del MCP de Playwright (e2e local)
.playwright-mcp/

# Capturas de verificación local (no son artefactos del proyecto)
*.png
!public/**/*.png
!assets-source/**/*.png
